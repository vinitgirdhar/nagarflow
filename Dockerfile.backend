# syntax=docker/dockerfile:1
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 \
    NAGARFLOW_ENV=production NAGARFLOW_STORAGE_DIR=/tmp/nagarflow \
    NAGARFLOW_INGEST_WORKER=false PORT=10000
RUN useradd --uid 10001 --user-group --create-home --shell /usr/sbin/nologin nagarflow
WORKDIR /app
COPY requirements.txt ./
RUN python -m pip install --no-cache-dir -r requirements.txt
COPY --chown=10001:10001 *.py ./
COPY --chown=10001:10001 scripts/ ./scripts/
COPY --chown=10001:10001 static/ ./static/
RUN mkdir -p /app/static/uploads /tmp/nagarflow \
    && chown 10001:10001 /app/static/uploads /tmp/nagarflow \
    && chmod 700 /tmp/nagarflow
EXPOSE 10000
ENTRYPOINT ["python", "scripts/render_service.py"]
CMD ["serve-api"]
HEALTHCHECK --interval=30s --timeout=5s --start-period=40s --retries=3 \
  CMD python -c "import os,urllib.request; urllib.request.build_opener(urllib.request.ProxyHandler({})).open('http://127.0.0.1:'+os.environ.get('PORT','10000')+'/api/health',timeout=4).read()"
